# OS cruft
.DS_Store
._*
Thumbs.db
desktop.ini

# Editor / tooling
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local devcontainer CLI install (`npm install -g` is preferred, but a local
# install is the usual fallback when running `devcontainer features test`).
node_modules/
package-lock.json
npm-debug.log*

# Backups written by tools/migrate-devcontainer.sh. These normally land in the
# project being migrated, not here, but ignore them so a dry run against a
# path inside this repo cannot accidentally commit one.
*.bak-*

# devcontainer CLI scratch output from `devcontainer features test`
.devcontainer/.tmp/
**/devcontainer-features-test/

# NOTE deliberately NOT ignored:
#   src/*/README.md             - generated by the release workflow (generate-docs)
#                                 and committed back, so it must stay tracked.
#   .devcontainer/devcontainer-lock.json
#                               - pins resolved feature digests; keep it tracked
#                                 if you want reproducible rebuilds of this repo's
#                                 own container.
