{
  "name": "${localWorkspaceFolderBasename}",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  "remoteUser": "vscode",

  "mounts": [
    "source=${localEnv:HOME}/.claude.devcontainer.clean,target=/home/vscode/.claude-seed,type=bind,readonly",
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },

  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:DEVCONTAINER_CLAUDE_CODE_OAUTH_TOKEN}"
  },

  "postCreateCommand": "sudo mkdir -p /home/vscode/.claude && sudo chown -R vscode:vscode /home/vscode/.claude && .devcontainer/scripts/init-claude-config.sh && .devcontainer/scripts/install-rtk.sh && .devcontainer/scripts/install-latex.sh"
}
